  <Triggers>
    <LogonTrigger>
      <UserId>DESKTOP-NOAOSCH\servidor itech</UserId>
    </LogonTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-21T18:40:47-03:00</StartBoundary>
      <Repetition>
        <Interval>PT1M</Interval>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "G:\Outros computadores\Meu computador\itech-erp FINAL\iniciar-servicos.ps1"</Arguments>
      <WorkingDirectory>G:\Outros computadores\Meu computador\itech-erp FINAL</WorkingDirectory>
    </Exec>
