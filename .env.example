# Autenticação JWT e Segurança
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Criptografia de senhas de aparelhos (opcional; utiliza JWT_SECRET por padrão se não informada)
DEVICE_PASSWORD_SECRET=
STORAGE_PROVIDER=local
SERVICE_ORDER_MAX_PHOTOS=8
SERVICE_ORDER_MAX_WIDTH=1920
SERVICE_ORDER_QUALITY=80

# Integração com Google Identity Services (GSI)
# Frontend: variável pública do Vite
# Backend: validação da audiência do token no servidor
GOOGLE_CLIENT_ID=seu-client-id-aqui.apps.googleusercontent.com

# Cloudflare R2 (opcional; habilita produção com STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

PUBLIC_TRACKING_URL=https://acompanhar.itechcelulareinformatica.com.br

PUBLIC_PORT=3102
PUBLIC_TRUST_PROXY=loopback
