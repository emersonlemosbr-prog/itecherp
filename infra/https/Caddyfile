{
    auto_https disable_redirects
    admin off
}

http://itech.internal {
    bind 192.168.1.199
    redir https://itech.internal{uri} 308
}

https://itech.internal, https://192.168.1.199 {
    bind 192.168.1.199
    tls internal
    reverse_proxy 127.0.0.1:4001 {
        flush_interval -1
    }
}
