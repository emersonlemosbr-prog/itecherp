# Configuração do Frontend Vite - iTech ERP
# Client ID do Google Cloud Console para o Google Identity Services (GSI)
VITE_GOOGLE_CLIENT_ID=seu-client-id-aqui.apps.googleusercontent.com

# URL base da API quando o frontend for hospedado separadamente do backend (ex: Cloudflare Pages)
# Deixe em branco ou remova para usar '/api' relativo (padrão quando backend e frontend rodam juntos)
# VITE_API_URL=https://api.itechcelulareinformatica.com.br/api
