# ==============================================================================
# Configuração do Frontend Vite — iTech ERP (Cloudflare Pages)
# ==============================================================================

# URL da API do backend hospedado no Render (terminando em /api)
# No Cloudflare Pages, configure esta variável em Settings > Environment Variables
# Exemplo: https://itecherp-backend.onrender.com/api
VITE_API_URL=https://itecherp-backend.onrender.com/api

# Client ID do Google Cloud Console para o Google Identity Services (GSI) - Opcional
VITE_GOOGLE_CLIENT_ID=seu-client-id-aqui.apps.googleusercontent.com
