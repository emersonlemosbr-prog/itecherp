# ==============================================================================
# iTech ERP — Configuração de Ambiente do Backend (Node.js / Express)
# ==============================================================================

# Porta do servidor (no Render o próprio Render injeta PORT automaticamente)
PORT=4001
NODE_ENV=production

# Conexão com o PostgreSQL no Supabase (Session Pooler ou Transaction Pooler - porta 6543 / 5432)
# Exemplo Supabase: postgresql://postgres.[project-ref]:[sua-senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave secreta para assinatura dos tokens JWT da aplicação (gere uma chave forte e aleatória)
JWT_SECRET=coloque-aqui-uma-chave-secreta-forte-aleatoria
JWT_EXPIRES_IN=24h

# Segredo temporário para recuperação/configuração emergencial da senha mestra do Superadmin (mínimo 16 caracteres)
# PLATFORM_RECOVERY_SECRET=defina-um-segredo-forte-temporario-aqui

# Origens permitidas no CORS (endereço do seu frontend no Cloudflare Pages)
# Exemplo: https://itecherp.pages.dev ou https://erp.seudominio.com.br
CORS_ORIGIN=https://itecherp.pages.dev

# Integração Google Identity Services (GSI) - Opcional
GOOGLE_CLIENT_ID=seu-client-id-aqui.apps.googleusercontent.com

# Acompanhamento Público de Ordens de Serviço
PUBLIC_TRACKING_URL=https://acompanhar.itechcelulareinformatica.com.br
PUBLIC_PORT=3102
PUBLIC_TRUST_PROXY=loopback

# Fotos das Ordens de Serviço (Armazenamento na Nuvem Cloudinary) - Opcional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
